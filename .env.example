# Copy these into your host's "Environment variables" page (or into a .env file if your host loads one).
# Only the first three matter for a first deploy. Everything else is optional.

# Folder for the database and uploads. On a host, point this at a persistent disk / volume (for example /data).
# Without a persistent disk, everything saved in the admin panel is lost on every redeploy.
DATA_DIR=/data

# Starting admin password (the admin email is rastogishrey1996@gmail.com). Change it under Account after the first sign-in.
ADMIN_PASSWORD=82sunset54

# Most hosts set PORT for you. Leave it out unless your host asks for one.
# PORT=3000

# Email alerts (new client briefs, grievances, daily digest) and the Account verification code.
# Gmail example: turn on 2-step verification, create an "App password" and use it below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=rastogishrey1996@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_FROM=rastogishrey1996@gmail.com

# Only if the website is served from a different address than this server (comma separated).
# ALLOWED_ORIGINS=https://yourname.com
